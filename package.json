{
  "name": "@nesinz/scopetrace",
  "version": "0.4.2",
  "description": "Local, evidence-based static analysis of GitHub OAuth, GitHub App permissions and Google Gmail, Drive and Calendar OAuth scopes.",
  "type": "module",
  "bin": {
    "scopetrace": "dist/cli/main.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "rules",
    "schemas",
    "docs",
    "examples",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    ".github/workflows/ci.yml",
    ".github/workflows/code-scanning.yml",
    ".github/scopetrace.config.json",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sinzbtw/scopetrace.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run coverage && npm run test:release && npm run build",
    "smoke": "node dist/cli/main.js --version",
    "test:release": "node --test scripts/release.test.mjs",
    "package:check": "node scripts/package-check.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check && npm run package:check"
  },
  "dependencies": {
    "picomatch": "^4.0.3",
    "typescript": "~5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/picomatch": "^4.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "types": "dist/index.d.ts",
  "overrides": {
    "minimatch": "^11.0.3"
  },
  "homepage": "https://github.com/sinzbtw/scopetrace#readme",
  "bugs": {
    "url": "https://github.com/sinzbtw/scopetrace/issues"
  },
  "keywords": [
    "oauth",
    "permissions",
    "static-analysis",
    "sarif",
    "github",
    "google-oauth",
    "least-privilege"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
