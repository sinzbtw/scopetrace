{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sinzbtw/scopetrace/blob/main/schemas/report.schema.json",
  "title": "ScopeTrace report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "toolVersion",
    "provider",
    "catalogVersion",
    "declaredScopes",
    "normalizedScopes",
    "analysis",
    "operations",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "toolVersion": {
      "type": "string"
    },
    "provider": {
      "const": "github-oauth"
    },
    "catalogVersion": {
      "type": "string"
    },
    "declaredScopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "normalizedScopes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesScanned",
        "complete",
        "notices",
        "limitations"
      ],
      "properties": {
        "filesScanned": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notice"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "column"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "method",
        "endpoint",
        "source",
        "location",
        "confidence"
      ],
      "properties": {
        "provider": {
          "const": "github-oauth"
        },
        "method": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "source": {
          "enum": [
            "fetch",
            "octokit-rest",
            "octokit-request",
            "octokit-graphql"
          ]
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "severity",
        "confidence",
        "message",
        "docs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ST-[a-f0-9]{16}$"
        },
        "category": {
          "enum": [
            "observed",
            "possibly_excessive",
            "insufficient",
            "unknown",
            "not_applicable"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high"
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "message": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "ruleId": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
