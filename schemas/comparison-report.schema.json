{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScopeTrace permission comparison report 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schemaVersion",
    "toolVersion",
    "provider",
    "relationVersions",
    "base",
    "head",
    "declarations",
    "changes",
    "summary",
    "analysis"
  ],
  "properties": {
    "kind": {
      "const": "permission-diff"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "toolVersion": {
      "type": "string"
    },
    "provider": {
      "enum": [
        "github-oauth",
        "github-app",
        "google-oauth",
        null
      ]
    },
    "relationVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github",
        "google"
      ],
      "properties": {
        "github": {
          "type": "string"
        },
        "google": {
          "type": "string"
        }
      }
    },
    "base": {
      "$ref": "#/$defs/snapshot"
    },
    "head": {
      "$ref": "#/$defs/snapshot"
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "before",
          "after",
          "severity",
          "confidence",
          "escalation",
          "message",
          "docs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ST-[0-9a-f]{16}$"
          },
          "kind": {
            "enum": [
              "added",
              "expanded",
              "reduced",
              "removed",
              "equivalent",
              "unknown"
            ]
          },
          "before": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/grant"
            }
          },
          "after": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/grant"
            }
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high"
            ]
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "escalation": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "docs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^https://"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "expanded",
        "reduced",
        "removed",
        "equivalent",
        "unknown",
        "escalations"
      ],
      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "expanded": {
          "type": "integer",
          "minimum": 0
        },
        "reduced": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "equivalent": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "escalations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "notices",
        "limitations"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "requestedBaseCommit",
        "baseCommit",
        "headCommit",
        "configPath"
      ],
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "merge-base"
          ]
        },
        "requestedBaseCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "headCommit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "configPath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "pullRequest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    }
  },
  "$defs": {
    "grant": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scope"
          ],
          "properties": {
            "kind": {
              "const": "scope"
            },
            "scope": {
              "type": "string"
            },
            "sensitivity": {
              "enum": [
                "non_sensitive",
                "sensitive",
                "restricted",
                "unknown"
              ]
            },
            "unmodeled": {
              "const": true
            },
            "sensitivityVerified": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "domain",
            "name",
            "level"
          ],
          "properties": {
            "kind": {
              "const": "permission"
            },
            "domain": {
              "enum": [
                "repository",
                "organization",
                "account"
              ]
            },
            "name": {
              "type": "string"
            },
            "level": {
              "enum": [
                "read",
                "write"
              ]
            }
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "provider",
        "grants",
        "unrecognizedCount",
        "context"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "provider": {
          "enum": [
            "github-oauth",
            "github-app",
            "google-oauth",
            null
          ]
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        },
        "unrecognizedCount": {
          "type": "integer",
          "minimum": 0
        },
        "tokenType": {
          "enum": [
            "installation",
            "user"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repositoryVisibility": {
              "enum": [
                "unknown",
                "public",
                "private"
              ]
            },
            "driveAccess": {
              "enum": [
                "unknown",
                "app-authorized",
                "app-data"
              ]
            },
            "calendarResources": {
              "enum": [
                "unknown",
                "owned",
                "app-created",
                "public"
              ]
            },
            "calendarData": {
              "enum": [
                "unknown",
                "events",
                "availability"
              ]
            }
          }
        }
      }
    }
  }
}
